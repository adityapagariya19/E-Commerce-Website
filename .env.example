APP_NAME="JB Optician"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (MySQL / MariaDB) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jb_optician
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# --- Mail (log = write emails to storage/logs/laravel.log; set smtp for real delivery) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="orders@jboptician.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Seeded admin (used ONLY by `php artisan db:seed`). CHANGE before any deployment. ---
ADMIN_SEED_EMAIL=admin@jboptician.test
ADMIN_SEED_PASSWORD=ChangeMe!12345

# --- Razorpay (TEST mode keys start with rzp_test_). Leave empty to disable the gateway. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Optional integrations ---
OMNISEND_API_KEY=
CHATBASE_BOT_ID=
GA4_MEASUREMENT_ID=

# Popular This Week: count seeded demo orders (is_demo=1) as sales? Keep false in production.
POPULAR_INCLUDE_DEMO=true

# Try-On (MyWebAR): per-product project links are set in Admin > Products. Allowed hosts: Admin > Settings.
